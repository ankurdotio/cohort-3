      "originalText": "export const MESSAGE_ROLES = Object.freeze([ 'user', 'assistant', 'tool' ]);\n\nexport const messageSchema = new mongoose.Schema({\n  role: {\n    type: String,\n    enum: MESSAGE_ROLES,\n    required: true\n  },\n  content: {\n    type: String,\n    required: true\n  },\n  conversation: {\n    type: mongoose.Schema.Types.ObjectId,\n    ref: 'Conversation', required: true\n  },\n}, { timestamps: { createdAt: 'createdAt', updatedAt: false } });",
