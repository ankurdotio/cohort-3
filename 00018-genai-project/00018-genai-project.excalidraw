        "code": "const model = new ChatGroq({\n    model: \"qwen/qwen3.8-27b\",\n    apiKey: env.GROQ_API_KEY\n})\n\n\nconst response = await model.invoke(`generate a title for a conversation\non the basis of user's first message\n\nuser's Message\n\n\"\"\"\nWrite an essay on INDIA.\n\"\"\"\n\n`)\n\n/*\n// response.content = Sure here is the title for the conversation \"Essay on India\"\n// response.content = \"Essay on India\". i have generate the title, let me know if you need any other help.\n*/\n\n",
