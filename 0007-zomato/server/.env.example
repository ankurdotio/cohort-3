# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/foodhub

# JWT (use long random strings in real projects)
ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Seed options (all optional, defaults shown)
CUSTOMER_COUNT=900000
OWNER_COUNT=100000
RESTAURANT_COUNT=1000000
ORDER_COUNT=10000000
REVIEW_COUNT=2000000
# Orders are spread over the 12 months before this date (YYYY-MM-DD).
# Leave empty to use today. Set the same date for the whole class to get byte-identical data.
SEED_END_DATE=
